#include <windows.h>

1 24 "livewall.manifest"

101 ICON "livewall.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "LiveWall"
            VALUE "FileDescription",  "LiveWall - animated desktop wallpapers"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "livewall"
            VALUE "OriginalFilename", "livewall.exe"
            VALUE "ProductName",      "LiveWall"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
