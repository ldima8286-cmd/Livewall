{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 (Release)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    },
    {
      "name": "mingw",
      "displayName": "MinGW-w64 / Ninja (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-console",
      "displayName": "MinGW-w64 / Ninja (Debug, console)",
      "inherits": "mingw",
      "binaryDir": "${sourceDir}/build/mingw-console",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIVEWALL_CONSOLE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "mingw",
      "configurePreset": "mingw"
    },
    {
      "name": "mingw-console",
      "configurePreset": "mingw-console"
    }
  ]
}
